{
  "manifest_version": 3,
  "name": "Bilibili 播放速度微调",
  "version": "1.1.0",
  "description": "无极精确调节 Bilibili 播放速度，用自定义微调面板替换原倍速菜单",
  "permissions": ["storage"],
  "host_permissions": ["*://*.bilibili.com/*"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bilibili 播放速度微调",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
